#!/usr/bin/env bash
#
# Does the Python port work? Answers it in one command.
#
#   ./week1_baseline/mcp/verify-python            # newest step (default)
#   ./week1_baseline/mcp/verify-python 10_standard_tool_library
#
# Offline and free: a stub MUD stands in for the game, and no LLM call is made. Nothing in your
# .boukensha/ is read or written — a throwaway config directory is used instead.

set -uo pipefail
cd "$(dirname "$0")/../.."
ROOT="$PWD"

# Which iteration to verify. Defaults to the newest Python step so this keeps testing the tip of
# the tree without being edited every time a step lands.
STEP="${1:-12_context}"
[ -d "$ROOT/week1_baseline/python/$STEP" ] || { echo "no such step: $STEP" >&2; exit 1; }

TMP="$(mktemp -d)"
# Each run points MUD_MANAGER_SOCKET at its own throwaway socket, so it gets its own detached
# daemon. Without this the daemon outlives the socket file and keeps a MUD connection open —
# they accumulate one per run and the character ends up "already in use" from stale logins.
shutdown_daemon() {
  [ -S "$TMP/daemon.sock" ] || return 0
  ruby -rsocket -rjson -e '
    begin
      s = UNIXSocket.new(ARGV[0])
      s.puts JSON.generate({"op" => "shutdown"})
      s.gets
      s.close
    rescue StandardError
    end' "$TMP/daemon.sock" 2>/dev/null
}

trap 'shutdown_daemon; rm -rf "$TMP"; [ -n "${MUD_PID:-}" ] && kill "$MUD_PID" 2>/dev/null' EXIT

# 1. a stub MUD on a free port
ruby "$ROOT/week1_baseline/mcp/fake_mud_server.rb" 0 > "$TMP/port" &
MUD_PID=$!
for _ in $(seq 1 50); do [ -s "$TMP/port" ] && break; sleep 0.1; done
PORT="$(cat "$TMP/port")"

# 2. a throwaway .boukensha that DOES declare the MCP server
mkdir -p "$TMP/.boukensha"
cat > "$TMP/.boukensha/settings.yaml" <<YAML
tasks:
  player:
    provider: anthropic
    model: claude-sonnet-4-6
mcp_servers:
  - name: mud
    command: mud-manager
    args: ["--mcp"]
    required: false
    env:
      MUD_MANAGER_SOCKET: "$TMP/daemon.sock"
      MUD_HOST: "127.0.0.1"
      MUD_PORT: "$PORT"
      MUD_USERNAME: Verifier
      MUD_PASSWORD: secret
      MUD_SESSION: verify-python
YAML

echo "Verifying the Python port (offline, no API calls)"
echo "  step $STEP, stub MUD on 127.0.0.1:$PORT, throwaway config in $TMP"
echo

cd "$ROOT/week1_baseline/python"
BOUKENSHA_DIR="$TMP/.boukensha" STEP="$STEP" MUD_HOST_T=127.0.0.1 MUD_PORT_T="$PORT" MUD_SOCKET_T="$TMP/daemon.sock" uv run python - <<'PY'
import os, sys

sys.path.insert(0, os.environ["STEP"])

import boukensha
from boukensha.context import Context
from boukensha.registry import Registry
# Step 12 deleted the Tasks classes and dropped Context's `task` argument. This script still
# accepts an older step as its argument, so it has to cope with both shapes.
try:
    from boukensha.tasks import Player
except ModuleNotFoundError:
    Player = None
from boukensha.tools import file_system, mcp, shell

failures = 0

def check(label, ok, detail=""):
    global failures
    if ok:
        print(f"  ok   {label}")
    else:
        failures += 1
        print(f"  FAIL {label}\n       {detail}")

cfg = boukensha.config()
check("config loads", cfg.dir == os.environ["BOUKENSHA_DIR"], cfg.dir)
check("mcp_servers is read from settings.yaml", len(cfg.mcp_servers()) == 1, cfg.mcp_servers())

ctx = (Context(system="t", working_dir=os.getcwd()) if Player is None
       else Context(task=Player, system="t", working_dir=os.getcwd()))
reg = Registry(ctx)

file_system.register(reg, working_dir=os.getcwd())
shell.register(reg, working_dir=os.getcwd())
# Step 12 disables list_directory and search_files (the player agent has no use for them), so
# the built-in count depends on which step is under test.
BUILTINS = 5 if Player is None else 7
check("filesystem + shell tools register", len(ctx.tools) == BUILTINS, sorted(ctx.tools))
check("pwd works", reg.dispatch("pwd", {}) == os.getcwd())
if "list_directory" in ctx.tools:
    check("list_directory works", os.environ["STEP"] in reg.dispatch("list_directory", {}))
check("run_command works", reg.dispatch("run_command", {"command": "echo hi"}).strip() == "hi")
check("path escapes are refused",
      reg.dispatch("read_file", {"path": "/etc/passwd"}).startswith("error:"))

clients = mcp.register_all(reg, cfg.mcp_servers())
check("MCP server started from config", len(clients) == 1)

if clients:
    check("server identified itself",
          clients[0].server_info.get("name") == "mud-manager", clients[0].server_info)
    # 34 MCP tools on top of the built-ins, whichever step is under test.
    check("MUD tools discovered", len(ctx.tools) >= BUILTINS + 34, f"{len(ctx.tools)} tools")
    check("optional params stayed optional", ctx.tools["look"].required_keys() == [])
    check("required params stayed required", ctx.tools["move"].required_keys() == ["direction"])
    room = reg.dispatch("look", {})
    check("Python played the MUD", "Temple" in room, room[:80])
    bad = reg.dispatch("move", {"direction": "sideways"})
    check("bad argument rejected with a readable message", "invalid direction" in bad, bad[:80])
    for c in clients:
        c.close()

# A login where the character is ALREADY connected. A real tbaMUD answers "You take over your
# own body, already in use!" instead of "Welcome" — a success, not an error. mud_manager 0.2.0
# did not match it, timed out, and turned every subsequent tool call into an error string; the
# model then invented an explanation for a game state it could not see. Regression guard.
from boukensha.mcp.client import Client as RawClient

takeover = RawClient(name="mud", command="mud-manager", args=["--mcp"], env={
    # The same throwaway socket the rest of this script uses. Without it this client would
    # reach the shared default daemon, whose "verify-takeover" session survives between runs
    # still pointing at the previous run's (now dead) stub port.
    "MUD_MANAGER_SOCKET": os.environ["MUD_SOCKET_T"],
    "MUD_HOST": os.environ["MUD_HOST_T"], "MUD_PORT": os.environ["MUD_PORT_T"],
    "MUD_USERNAME": "takeover", "MUD_PASSWORD": "secret", "MUD_SESSION": "verify-takeover",
})
try:
    takeover.start()
    room = takeover.call_tool("look", {})
    check("a login that takes over an existing body still works", "Temple" in room, room[:120])
    takeover.close()
except Exception as error:
    check("a login that takes over an existing body still works", False, str(error)[:160])

print()
print("PYTHON PORT WORKS" if failures == 0 else f"{failures} check(s) failed")
sys.exit(1 if failures else 0)
PY
